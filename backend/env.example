PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skin_mage

# JWT settings
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# ML integration (optional)
# If set, backend will call a python script to do inference.
# The script should print JSON to stdout, e.g. {"label":"Acne","confidence":0.87}
MODEL_PREDICT_SCRIPT=ml/predict.py
MODEL_INPUT_SIZE=224

# Optional mapping from model class index to disease label
LABELS_JSON=ml/labels.json

# Admin registration
# If you want to restrict admin registration, set ADMIN_INVITE_CODE to a secret.
# If empty, anyone can register as admin (NOT recommended for production).
ADMIN_INVITE_CODE=

